<?xml version="1.0" encoding="utf-8"?>
<!-- Strela : tout reste sur le téléphone. Manifeste commun aux deux variantes (lot 6) ; INTERNET et
     REQUEST_INSTALL_PACKAGES (mise à jour depuis GitHub) sont dans celui de la variante github seulement
     (src/github/AndroidManifest.xml) : la variante play n'a aucun accès réseau. VIBRATE : vibreur natif. Pas de
     permission caméra : la prise de vue passe par l'appareil photo d'Android (ACTION_IMAGE_CAPTURE), qui a la sienne.
     Pas de permission de stockage : l'export va dans Téléchargements/Strela par MediaStore, l'import passe par le
     sélecteur de fichiers d'Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Strela"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Fichiers partagés : sauvegarde (menu de partage) et photo prise par l'appareil photo -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
