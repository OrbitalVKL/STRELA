<?xml version="1.0" encoding="utf-8"?>
<!-- Strela : tout reste sur le téléphone. INTERNET sert seulement à la mise à jour (dernière release GitHub de
     OrbitalVKL/STRELA, sur demande dans les Réglages) ; REQUEST_INSTALL_PACKAGES : installer cette mise à jour
     (Android exige la même signature). VIBRATE : vibreur natif. Pas de permission caméra : la prise de vue passe par
     l'appareil photo d'Android (ACTION_IMAGE_CAPTURE), qui a la sienne. Pas de permission de stockage : l'export va
     dans Téléchargements/Strela par MediaStore, l'import passe par le sélecteur de fichiers d'Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Strela"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Fichiers partagés : sauvegarde (menu de partage) et photo prise par l'appareil photo -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="fr.orbitalvkl.strela.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
